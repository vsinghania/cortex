# Node dependencies
node_modules/
# Lockfiles are tracked: `npm ci` requires one, in CI and in the Dockerfile.

# Build outputs
dist/
build/
out/
/lib/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.pid.lock
*.seed

# Testing and coverage
coverage/
.nyc_output/
.jest/
jest-cache/
jest-test-results.json

# Playwright reports (if used)
playwright-report/
test-results/
blob-report/

# TypeScript
*.tsbuildinfo

# Linters and tooling caches
.eslintcache
.turbo/
.parcel-cache/
.cache/

# Environment files
.env
.env.*
!.env.example
# Frontend build-time config is not secret (it ships in the public bundle), so
# its per-mode files are committed; personal overrides go in web/.env.local (ignored).
!web/.env.development
!web/.env.production
.envrc

# Deploy config (account-specific values; template is committed)
deploy/aws.env

# OS-specific files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp
*.swo

# Cline local state
.cline
.cline/

# Claude Code local state
.claude/plans/
