# Environment variables for cortex

# Server
PORT=3000
LOG_LEVEL=info

# MongoDB (Mongoose) - base connection parameters used at the edge (server.ts)
# The app bootstraps a base connection using only host and port.
# Repositories request per-db connections as needed via the connection manager.
MONGO_HOST=localhost
MONGO_PORT=27017
# Application database name used by repositories
MONGO_DB_APP=cortex

# CORS
# Comma-separated list of origins allowed to send credentials (cookies) and requests.
# Example for local dev frontends:
CORS_ORIGINS=http://localhost:3000

# Auth - JWT Access Tokens
# Keep secrets safe in real environments (use a strong random value).
JWT_ACCESS_SECRET=change_me_in_prod
# Access token lifetime (seconds). Default 900 = 15 minutes.
ACCESS_TOKEN_TTL_SEC=900
# Optional issuer/audience claims
# JWT_ISSUER=cortex
# JWT_AUDIENCE=cortex_client

# Auth - Refresh Tokens (opaque, stored in HttpOnly cookie)
REFRESH_TOKEN_TTL_SEC=604800 # 7 days
REFRESH_COOKIE_NAME=rt
# Cookie security options
COOKIE_SECURE=false           # set to true in production behind HTTPS
COOKIE_SAMESITE=lax          # lax|strict|none (use none only with HTTPS)
# COOKIE_DOMAIN=localhost     # optional: set if serving on a custom domain

# Rate Limiting for auth endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
AUTH_RATE_LIMIT_MAX=60            # 60 requests per IP per window

# Password hashing
BCRYPT_SALT_ROUNDS=12

# Agents (OpenAI Agents SDK)
# Provider for agent layer: openai | anthropic | local (future)
AGENT_PROVIDER=openai
# Required when using OpenAI provider
# DO NOT put real keys in this example file; use your local .env instead.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Defaults used by OpenAI Agents adapter
OPENAI_AGENT_DEFAULT_MODEL=gpt-4o-mini
OPENAI_AGENT_TIMEOUT_MS=10000
OPENAI_AGENT_RETRIES=3
