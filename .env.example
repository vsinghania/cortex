# Environment variables for cortex

# Server
PORT=3000
LOG_LEVEL=info

# Number of reverse-proxy hops in front of the app, used to resolve the real
# client IP from X-Forwarded-For (req.ip, and therefore the auth rate limiter).
# 0 = no proxy, correct for local dev. Set to 1 behind a single ALB/CDN.
# Never use Express's `true`: it makes X-Forwarded-For trivially spoofable.
TRUST_PROXY_HOPS=0

# MongoDB (Mongoose) - base connection parameters used at the edge (server.ts)
# The app bootstraps a base connection using only host and port.
# Repositories request per-db connections as needed via the connection manager.
MONGO_HOST=localhost
MONGO_PORT=27017

# Optional namespace to prefix db names (no app name baked in). Example: dev|staging|prod|org
# When set, derived DB names look like: ${MONGO_DB_NAMESPACE}_{service}_db (e.g., dev_user_db)
# If you set explicit per-service names below, those are used verbatim.
# MONGO_DB_NAMESPACE=dev

# Per-service DB names (preferred). If unset, DbNameResolver falls back to:
# 1) MONGO_DB_NAMESPACE + _{service}_db
# 2) MONGO_DB_APP + _{service}_db
# 3) {service}_db
# Uncomment and set as needed.
# MONGO_DB_AUTH=auth_db
# MONGO_DB_USER=user_db
# MONGO_DB_NOTES=notes_db
# MONGO_DB_QUIZ=quiz_db
# MONGO_DB_AGENT=agent_db

# Legacy single app DB (backward-compat fallback used by DbNameResolver if service-specific is unset)
# Safe to keep for gradual migration.
MONGO_DB_APP=cortex

# CORS
# Comma-separated list of origins allowed to send credentials (cookies) and requests.
# Example for local dev frontends:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth - JWT Access Tokens
# Keep secrets safe in real environments (use a strong random value).
JWT_ACCESS_SECRET=change_me_in_prod
# Access token lifetime (seconds). Default 900 = 15 minutes.
ACCESS_TOKEN_TTL_SEC=900
# Optional issuer/audience claims
# JWT_ISSUER=cortex
# JWT_AUDIENCE=cortex_client

# Auth - Refresh Tokens (opaque, stored in HttpOnly cookie)
REFRESH_TOKEN_TTL_SEC=604800 # 7 days
REFRESH_COOKIE_NAME=rt
# Cookie security options
COOKIE_SECURE=false           # set to true in production behind HTTPS
COOKIE_SAMESITE=lax          # lax|strict|none (use none only with HTTPS)
# COOKIE_DOMAIN=localhost     # optional: set if serving on a custom domain

# Rate Limiting for auth endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
AUTH_RATE_LIMIT_MAX=60            # 60 requests per IP per window

# Password hashing
BCRYPT_SALT_ROUNDS=12

# OpenAI
# DO NOT put real keys in this example file; use your local .env instead.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Embedding model used for the RAG pipeline (chunk + query embeddings).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant (vector store) - run locally with: npm run qdrant:up
QDRANT_URL=http://localhost:6333
# Only needed when targeting Qdrant Cloud or an authed instance:
# QDRANT_API_KEY=

# RAG runtime tuning
RAG_TOP_K=8
RAG_ANSWER_MODEL=gpt-5.4-nano
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# MCP - Notes
# Bearer token required by the notes MCP HTTP server. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_NOTES_AUTH_TOKEN=YOUR_MCP_NOTES_AUTH_TOKEN
# MCP_NOTES_HOST=127.0.0.1
# MCP_NOTES_PORT=3010
# MCP_NOTES_PATH=/mcp

# Internal URL the web-server uses to forward /mcp/notes requests to the
# standalone notes MCP server. Must include the upstream's path component.
MCP_NOTES_INTERNAL_URL=http://127.0.0.1:3010/mcp

# Voice (Realtime) - Phase 3
# Provider for the hands-free note capture agent. Adapter is selected via
# VoiceAdapterRegistry. Currently supported: openai.
VOICE_PROVIDER=openai
# OpenAI-specific knobs read by OpenAiRealtimeAdapter.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
# Public URL OpenAI uses to reach our MCP proxy. OpenAI hosts the MCP client,
# so this must be reachable from the internet — a Cloudflare Tunnel or ngrok
# URL locally, the real API host in production. The path is the mounted proxy
# route, /api/v1/mcp/notes, with no trailing slash. Leave unset to mint
# sessions WITHOUT MCP tool attachment (useful for early UI/audio iteration
# before the tunnel is set up).
# VOICE_MCP_PUBLIC_URL=https://your-tunnel-host.example.com/api/v1/mcp/notes

# --- Background jobs (jobs_svc) -------------------------------------------
# Mongo database for the job queue. Defaults to {MONGO_DB_NAMESPACE|MONGO_DB_APP}_jobs_db.
# MONGO_DB_JOBS=jobs_db
# Whether this process runs the worker loop. The worker is in-process with
# web-server today; set false to make a process enqueue-only (the notes MCP
# server never runs one, since it only ever enqueues).
JOBS_WORKER_ENABLED=true
# Whether this process ticks recurring schedules into jobs. Safe to leave on in
# more than one process - the tick advances next_run_at atomically, so a window
# materializes once - but it is pointless work beyond the first.
JOBS_SCHEDULER_ENABLED=true
# Jobs run at once per worker. 1 by design: the notes re-index is serial, and
# parallel embedding risks OpenAI rate limits.
JOBS_CONCURRENCY=1
JOBS_POLL_INTERVAL_MS=2000
JOBS_POLL_MAX_INTERVAL_MS=10000
# Lease length. A worker must heartbeat within this or its job is reclaimed as
# crashed; handlers may declare a longer one (the re-index uses 5 minutes).
JOBS_LEASE_MS=120000
# How long the drain waits for in-flight jobs on SIGTERM. Must stay inside the
# compose stop_grace_period (30s) with margin for the forced exit at 28s.
JOBS_DRAIN_DEADLINE_MS=25000
JOBS_MAX_ATTEMPTS=3
