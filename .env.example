# Environment variables for cortex

# Server
PORT=3000
LOG_LEVEL=info

# Number of reverse-proxy hops in front of the app, used to resolve the real
# client IP from X-Forwarded-For (req.ip, and therefore the auth rate limiter).
# 0 = no proxy, correct for local dev. Set to 1 behind a single ALB/CDN.
# Never use Express's `true`: it makes X-Forwarded-For trivially spoofable.
TRUST_PROXY_HOPS=0

# MongoDB (Mongoose) - base connection parameters used at the edge (server.ts)
# The app bootstraps a base connection using only host and port.
# Repositories request per-db connections as needed via the connection manager.
MONGO_HOST=localhost
MONGO_PORT=27017

# Optional namespace to prefix db names (no app name baked in). Example: dev|staging|prod|org
# When set, derived DB names look like: ${MONGO_DB_NAMESPACE}_{service}_db (e.g., dev_user_db)
# If you set explicit per-service names below, those are used verbatim.
# MONGO_DB_NAMESPACE=dev

# Per-service DB names (preferred). If unset, DbNameResolver falls back to:
# 1) MONGO_DB_NAMESPACE + _{service}_db
# 2) MONGO_DB_APP + _{service}_db
# 3) {service}_db
# Uncomment and set as needed.
# MONGO_DB_AUTH=auth_db
# MONGO_DB_USER=user_db
# MONGO_DB_NOTES=notes_db
# MONGO_DB_QUIZ=quiz_db
# MONGO_DB_AGENT=agent_db

# Legacy single app DB (backward-compat fallback used by DbNameResolver if service-specific is unset)
# Safe to keep for gradual migration.
MONGO_DB_APP=cortex

# CORS
# Comma-separated list of origins allowed to send credentials (cookies) and requests.
# Example for local dev frontends:
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Auth - JWT Access Tokens
# Keep secrets safe in real environments (use a strong random value).
JWT_ACCESS_SECRET=change_me_in_prod
# Access token lifetime (seconds). Default 900 = 15 minutes.
ACCESS_TOKEN_TTL_SEC=900
# Optional issuer/audience claims
# JWT_ISSUER=cortex
# JWT_AUDIENCE=cortex_client

# Auth - Refresh Tokens (opaque, stored in HttpOnly cookie)
REFRESH_TOKEN_TTL_SEC=604800 # 7 days
REFRESH_COOKIE_NAME=rt
# Cookie security options
COOKIE_SECURE=false           # set to true in production behind HTTPS
COOKIE_SAMESITE=lax          # lax|strict|none (use none only with HTTPS)
# COOKIE_DOMAIN=localhost     # optional: set if serving on a custom domain

# Rate Limiting for auth endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
AUTH_RATE_LIMIT_MAX=60            # 60 requests per IP per window
# Stricter limit for endpoints that send an email (forgot password), stacked on
# top of the one above.
EMAIL_SEND_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
EMAIL_SEND_RATE_LIMIT_MAX=5             # 5 sends per IP per window

# Password hashing
BCRYPT_SALT_ROUNDS=12

# OpenAI
# DO NOT put real keys in this example file; use your local .env instead.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Embedding model used for the RAG pipeline (chunk + query embeddings).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (optional) - the adapter is only registered when ANTHROPIC_API_KEY is set.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5
ANTHROPIC_TIMEOUT_MS=30000
ANTHROPIC_RETRIES=3

# Qdrant (vector store) - run locally with: npm run qdrant:up
QDRANT_URL=http://localhost:6333
# Only needed when targeting Qdrant Cloud or an authed instance:
# QDRANT_API_KEY=

# RAG runtime tuning
RAG_TOP_K=8
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# MCP - Notes
# Bearer token required by the notes MCP HTTP server. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_NOTES_AUTH_TOKEN=YOUR_MCP_NOTES_AUTH_TOKEN
# MCP_NOTES_HOST=127.0.0.1
# MCP_NOTES_PORT=3010
# MCP_NOTES_PATH=/mcp
# Verifies the signed caller assertion the public MCP gateway (web-server) sends the
# notes MCP server for external assistants and voice. Set the same value for both
# processes; distinct from MCP_NOTES_AUTH_TOKEN. Unset, the notes server accepts only
# internal callers holding MCP_NOTES_AUTH_TOKEN. Generate like that token.
MCP_GATEWAY_ASSERTION_SECRET=YOUR_MCP_GATEWAY_ASSERTION_SECRET

# Internal URL the web-server's public notes gateway (MCP_PUBLIC_BASE_URL/notes)
# forwards to: the standalone notes MCP server. Must include the upstream's path.
MCP_NOTES_INTERNAL_URL=http://127.0.0.1:3010/mcp

# Public MCP - the resource servers ChatGPT, Claude and other MCP clients reach with a
# per-user access token, one per MCP server at MCP_PUBLIC_BASE_URL + its path (notes:
# MCP_PUBLIC_BASE_URL/notes; tokens are bound to that URL). A server is served only when
# its internal URL (MCP_NOTES_INTERNAL_URL, ...) is set. MCP_PUBLIC_BASE_URL turns them
# on and needs MCP_GATEWAY_ASSERTION_SECRET plus OAUTH_ISSUER_URL, the authorization
# server they advertise and accept tokens from: a different host in production
# (api.cortexapp.me vs mcp.cortexapp.me), the same one locally. Plain http is
# fine for localhost; claude.ai and ChatGPT need a tunnel's https URL. To test by hand,
# mint a token with scripts/mint_mcp_dev_token.ts.
MCP_PUBLIC_BASE_URL=http://localhost:3000

# OAuth authorization server - issues the per-user access tokens for the public MCP
# resources above, with its consent page on APP_PUBLIC_URL (required with it). Its
# identifier and host: api.cortexapp.me in production. Leave unset to disable.
OAUTH_ISSUER_URL=http://localhost:3000

# Voice (Realtime) - Phase 3
# Provider for the hands-free note capture agent. Adapter is selected via
# VoiceAdapterRegistry. Currently supported: openai.
VOICE_PROVIDER=openai
# OpenAI-specific knobs read by OpenAiRealtimeAdapter.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
# Voice sessions reach the notes through the public notes MCP (MCP_PUBLIC_BASE_URL/notes)
# with a per-user token, so they need the Public MCP settings above. OpenAI hosts the MCP
# client, so that URL must be reachable from the internet: locally, override it with a
# tunnel (Cloudflare Tunnel, ngrok) pointing at the web-server's /notes. Without either,
# sessions mint WITHOUT MCP tools.
# VOICE_MCP_PUBLIC_URL=https://your-tunnel-host.example.com/notes

# --- Background jobs (jobs_svc) -------------------------------------------
# Mongo database for the job queue. Defaults to {MONGO_DB_NAMESPACE|MONGO_DB_APP}_jobs_db.
# MONGO_DB_JOBS=jobs_db
# Jobs run in the worker service (npm run worker:dev); web-server and the notes
# MCP server only enqueue. JOBS_SCHEDULER_ENABLED is read by web-server, the
# rest by the worker.
# Whether web-server ticks recurring schedules into jobs. Safe to leave on in
# more than one process - the tick advances next_run_at atomically, so a window
# materializes once - but it is pointless work beyond the first.
JOBS_SCHEDULER_ENABLED=true
# Jobs run at once per worker. 1 by design: the notes re-index is serial, and
# parallel embedding risks OpenAI rate limits.
JOBS_CONCURRENCY=1
JOBS_POLL_INTERVAL_MS=2000
JOBS_POLL_MAX_INTERVAL_MS=10000
# Lease length. A worker must heartbeat within this or its job is reclaimed as
# crashed; handlers may declare a longer one (the re-index uses 5 minutes).
JOBS_LEASE_MS=120000
# How long the drain waits for in-flight jobs on SIGTERM. Must stay inside the
# compose stop_grace_period (30s) with margin for the forced exit at 28s.
JOBS_DRAIN_DEADLINE_MS=25000
JOBS_MAX_ATTEMPTS=3

# --- Mail (mailer_svc) -----------------------------------------------------
# SMTP is the only transport. Locally, run Mailpit (`npm run mailpit:up`) and
# read every message at http://localhost:8025 - nothing it receives leaves your
# machine. `npm run mailer:smoke` sends a test message through this config.
MAIL_TRANSPORT=smtp
MAIL_FROM="Cortex <no-reply@cortexapp.me>"
SMTP_HOST=localhost
SMTP_PORT=1025
# Defaults to true only on port 465 (TLS from the first byte); 587 starts plain
# and upgrades via STARTTLS.
SMTP_SECURE=false
# Set both or neither. Mailpit needs neither.
# SMTP_USER=
# SMTP_PASS=
# SPA origin that links in emails (password reset, ...) point to.
APP_PUBLIC_URL=http://localhost:5173

# Google sign-in (optional; disabled while the client id and secret are unset).
# Create a "Web application" OAuth client in Google Cloud Console and add the
# redirect URI below to its authorized redirect URIs.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Encryption at rest for credentials we have to replay (the OneNote token cache).
# Entries are "<key_id>:<base64 of 32 random bytes>", comma-separated; the active id
# is the one new values are sealed with, and older ids stay listed so their values
# still open. Generate one with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
# SECRET_ENCRYPTION_KEYS=
# SECRET_ENCRYPTION_ACTIVE_KEY_ID=k1

# OneNote sync (optional; disabled while the client id and secret are unset, and
# also while the encryption keys above are unset - there would be nowhere safe to
# keep the grant). Register an app in the Azure portal, add the redirect URI below,
# and grant the delegated permissions Notes.Read and User.Read.
# MS_OAUTH_CLIENT_ID=
# MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/onenote/callback
# Override only to point at a mock or a national cloud; the default is correct.
# GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
